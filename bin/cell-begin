#!/usr/bin/env python3
"""cell-begin — raise the 4+1 cell in its own workspace. A free corner gesture.

LAW ENCODED HERE
  * Resolves the workspace by LABEL "the-cell" — never by id arithmetic (verified trap:
    layout.apply re-mints tab and pane ids, and pane ids are not in visual order).
  * REFUSES to touch a cell that is already standing. layout.apply REPLACES a tab; run
    over a live cell it would kill the plugin podium and the desks. A standing cell is
    never overwritten by a machine — re-raising is a human's decision, and even then it
    is close-then-begin, not begin-over-begin.
  * Never passes focus:true. The human's view is his.
  * Never names, reads or writes workspace w1 (Amihai's own session).
  * Boots no agents. Writes no question. Opens no plugin pane (see NOTE below).

NOTE — where `begin` deliberately stops (an open question for Amihai, not a decision
I took for him): this raises the score's cell, whose podium is the non-shell `watch`
viewer from cell.layout.json. Handing the center to the plugin (`plugin.pane.open`)
is a structural act; v1 prints the exact next step and does not take it. If he says
`begin` may take its own center, that is one added block here and a maturation-log entry.

Exit codes
  0  the cell now stands (raised by this run)
  2  usage / bad environment
  3  REFUSED: a cell is already standing (nothing was changed)
  5  the score file is missing or unreadable
  6  a herdr call failed (nothing was changed beyond what the message says)
"""
from __future__ import annotations

import json
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
from _cell_api import CellApiError, call  # noqa: E402

CELL_LABEL = "the-cell"
FORBIDDEN_WORKSPACE = "w1"  # never touched, whatever the label says
DESKS = ("G", "Q", "P", "V")


def score() -> dict:
    """The authored layout. plugin_root/cell.layout.json — never a guessed tree."""
    root = os.environ.get("HERDR_PLUGIN_ROOT") or os.path.dirname(
        os.path.dirname(os.path.realpath(__file__))
    )
    path = os.path.join(root, "cell.layout.json")
    try:
        with open(path, encoding="utf-8") as handle:
            data = json.load(handle)
    except (OSError, json.JSONDecodeError) as exc:
        print(f"REFUSED: cannot read the score at {path}: {exc}", file=sys.stderr)
        raise SystemExit(5)
    if "root" not in data:
        print(f"REFUSED: {path} has no `root` layout node.", file=sys.stderr)
        raise SystemExit(5)
    return data


def find_cell() -> dict | None:
    for workspace in call("workspace.list").get("workspaces", []):
        if workspace.get("label") == CELL_LABEL:
            return workspace
    return None


def panes_of(workspace_id: str) -> list[dict]:
    return call("pane.list", {"workspace_id": workspace_id}).get("panes", [])


def describe(panes: list[dict]) -> str:
    return ", ".join(
        f"{pane.get('label') or '(unlabelled)'}={pane.get('pane_id')}" for pane in panes
    ) or "(no panes)"


def main() -> int:
    data = score()
    workspace_spec = data.get("workspace", {})
    if workspace_spec.get("label", CELL_LABEL) != CELL_LABEL:
        print("REFUSED: the score's workspace label is not 'the-cell'.", file=sys.stderr)
        return 2

    existing = find_cell()
    if existing is not None:
        workspace_id = existing.get("workspace_id", "")
        if workspace_id == FORBIDDEN_WORKSPACE:
            print(
                f"REFUSED: a workspace labelled '{CELL_LABEL}' resolved to "
                f"{FORBIDDEN_WORKSPACE}, which this cell never touches.",
                file=sys.stderr,
            )
            return 3
        panes = panes_of(workspace_id)
        if panes:
            print(f"REFUSED: the cell is already standing in {workspace_id}.")
            print(f"  panes: {describe(panes)}")
            print("  layout.apply would REPLACE this tab and take the podium with it.")
            print("  Nothing was changed. Close the cell by hand first if you mean to re-raise it.")
            return 3
        print(f"workspace '{CELL_LABEL}' exists as {workspace_id} but holds no panes.")
        print("  Refusing to apply a layout into a workspace whose state I cannot explain.")
        print("  Nothing was changed.")
        return 3

    created = call(
        "workspace.create",
        {
            "label": CELL_LABEL,
            "cwd": workspace_spec.get("cwd", "/home/deploy/the-cell"),
            "focus": False,  # hard-coded: the score may not ask for the human's view
        },
    )
    workspace_id = created.get("workspace", {}).get("workspace_id")
    tab_id = created.get("tab", {}).get("tab_id")
    if not workspace_id or not tab_id:
        print(f"herdr returned an unexpected workspace.create result: {created}", file=sys.stderr)
        return 6
    print(f"raised workspace {workspace_id} (label '{CELL_LABEL}'), tab {tab_id}")

    # tab_id XOR workspace_id — passing both returns invalid_target (verified trap).
    call("layout.apply", {"root": data["root"], "tab_id": tab_id, "focus": False})

    panes = panes_of(workspace_id)  # ids are re-minted by apply: always re-resolve
    print(f"the cell stands: {describe(panes)}")
    # The centre is the pane that is NOT one of the four corners — structural, never a name match.
    # Verified 2026-08-24: the score's interim pane is labelled "podium", but a plugin-owned podium
    # takes its label from the manifest pane's `title` ("THE QUESTION"). Counting corners survives
    # both, and survives whatever the title becomes next.
    centre = next((p for p in panes if (p.get("label") or "") not in DESKS), None)
    print("")
    print("The centre is the score's non-shell viewer. To hand it to the plugin — a")
    print("structural act, and Amihai's to attest, not mine to take:")
    if centre:
        print(
            "  herdr plugin pane open --plugin cell.fiveqln --entrypoint podium "
            f"--placement split --target-pane {centre.get('pane_id')} --no-focus"
        )
    print("No agents were booted. No question was written. Workspace w1 was never named.")
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except CellApiError as exc:
        print(f"STOP: {exc}", file=sys.stderr)
        sys.exit(6)
